{
  "schema_version": 1,
  "app": "demoapp",
  "slug": "category_products",
  "kind": "page",
  "meta": {
    "title": "Products of the category",
    "url": "category-products/",
    "url_name": "category_products",
    "permissions": {
      "view": [
        "demoapp.view_product"
      ]
    },
    "parent": {
      "model": "demoapp.ProductCategory"
    }
  },
  "assets": {
    "css": ".category-products .x_title h2 { font-weight: 600; }",
    "js": "document.documentElement.dataset.categoryProducts = 'ready';"
  },
  "forms": {
    "category_product_form": {
      "model": "demoapp.Product",
      "fields": [
        "name",
        "price",
        "status",
        "tags"
      ]
    }
  },
  "root": {
    "type": "page",
    "id": "page",
    "children": [
      {
        "type": "row",
        "id": "main",
        "children": [
          {
            "type": "col",
            "id": "body",
            "props": {
              "width": 12
            },
            "children": [
              {
                "type": "html",
                "id": "back",
                "props": {
                  "html": "<p class=\"category-products\"><a href=\"/designs/dashboard\">Back to the dashboard</a></p>"
                }
              },
              {
                "type": "inline_object_management",
                "id": "products",
                "props": {
                  "model": "demoapp.Product",
                  "form": "category_product_form",
                  "parent_field": "category",
                  "list_fields": [
                    "name",
                    "price",
                    "status",
                    "tags"
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
