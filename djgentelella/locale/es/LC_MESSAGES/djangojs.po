#: static/gentelella/js/base/digital_signature.js:1057
msgid ""
"An error has occurred in the internal server of the uncontrolled 'Firmador "
"Libre'."
msgstr ""
"Ha ocurrido un error no controlado en el servidor interno de 'Firmador "
"Libre'."

#: static/gentelella/js/base/digital_signature.js:1061
msgid ""
"Make sure to start the 'Firmador Libre' application. If it is already "
"running, please press the reload button."
msgstr ""
"Asegúrate de iniciar la aplicación 'Firmador Libre'. Si ya está en ejecución,"
" presiona el botón de recarga."

#: static/gentelella/js/base/digital_signature.js:1065
msgid ""
"There is no card connected to the device. Please press the reload button and "
"connect your card."
msgstr ""
"No hay tarjeta conectada al dispositivo. Presiona el botón de recarga y "
"conecta tu tarjeta."

#: static/gentelella/js/base/digital_signature.js:1069
msgid ""
"The internal signature service does not work. Please contact the support."
msgstr "El servicio de firma interna no funciona. Contacta con el soporte."

#: static/gentelella/js/base/digital_signature.js:1073
msgid ""
"Authentication failed because the PIN entry window was detected closed, "
"please try again."
msgstr ""
"La autenticación falló porque la ventana de entrada PIN fue detectada "
"cerrada, intenta de nuevo."

#: static/gentelella/js/base/digital_signature.js:1078
msgid ""
"The device was disconnected, possibly the window was closed for signature. "
"Please close the window for the authentication PIN."
msgstr ""
"El dispositivo se desconectó, posiblemente la ventana para la firma se cerró."
" Cierra la ventana para la autenticación PIN."

#: static/gentelella/js/base/digital_signature.js:1082
msgid "The new signature field position overlaps with an existing signature."
msgstr "El nuevo campo de firma se superpone con una firma existente."

#: static/gentelella/js/base/digital_signature.js:1086
msgid "The new signature field position is outside the page dimensions."
msgstr "El nuevo campo de firma está fuera de los límites de la página."

#: static/gentelella/js/base/digital_signature.js:1090
msgid "The version of one or more libraries is incompatible."
msgstr "La versión de una o más bibliotecas es incompatible."

#: static/gentelella/js/base/digital_signature.js:1094
msgid "The cryptographic provider is not available."
msgstr "El proveedor de criptografía no está disponible."

#: static/gentelella/js/base/digital_signature.js:1098
msgid "The signing algorithm is not available."
msgstr "El algoritmo de firma no está disponible."

#: static/gentelella/js/base/digital_signature.js:1102
msgid ""
"Errors have been encountered in the data to be sent to the 'Free Signer'. "
"Please press the reload button and try again."
msgstr ""
"Se han encontrado errores en los datos que se enviarán al 'Firmador Libre'. "
"Presiona el botón de recarga y intenta de nuevo."

#: static/gentelella/js/base/digital_signature.js:1106
msgid ""
"The request to the signing service timed out. Please, press the reload button"
" and try again."
msgstr ""
"El tiempo de espera del servicio de firma ha expirado. Presiona el botón de "
"recarga y intenta de nuevo."

#: static/gentelella/js/base/digital_signature.js:1110
msgid ""
"We're sorry, an unexpected error occurred. Please, press the reload button "
"and try again."
msgstr ""
"Lo sentimos, ha ocurrido un error inesperado. Presiona el botón de recarga y "
"intenta de nuevo."

