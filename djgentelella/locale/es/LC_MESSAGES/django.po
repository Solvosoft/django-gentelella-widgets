#: designs/components.py designs/pipeline.py
#, python-format
msgid "no pipeline step %r is registered"
msgstr "no hay ningún paso de pipeline %r registrado"

#: designs/pipeline.py
msgid "only a step of a form over a model can declare \"writes\""
msgstr "solo un paso de un formulario sobre un modelo puede declarar \"writes\""

#: designs/pipeline.py
#, python-format
msgid "%r is the version of optimistic locking: no step may set it"
msgstr "%r es la versión del bloqueo optimista: ningún paso puede fijarla"

#: designs/pipeline.py
#, python-format
msgid "%r is not a field a step can set"
msgstr "%r no es un campo que un paso pueda fijar"

#: designs/pipeline.py
msgid "\"page:\" needs a path"
msgstr "\"page:\" necesita una ruta"

#: designs/pipeline.py
#, python-format
msgid "%r leads back to this page before it is drawn: a redirect loop"
msgstr "%r lleva de vuelta a esta página antes de dibujarla: un ciclo de redirecciones"

#: designs/pipeline.py
#, python-format
msgid "no design page %r is published"
msgstr "no hay ninguna página de diseño %r publicada"

#: designs/pipeline.py
#, python-format
msgid "design page %(page)r is about one %(parent)s: a branch can only go there after saving one"
msgstr "la página de diseño %(page)r es sobre un %(parent)s: una rama solo puede ir ahí después de guardar uno"

#: designs/pipeline.py
msgid "a branch to a flow needs the object a form saved"
msgstr "una rama a un flujo necesita el objeto que guardó un formulario"

#: designs/pipeline.py
#, python-format
msgid "%r is not a local path"
msgstr "%r no es una ruta local"

#: designs/pipeline.py
#, python-format
msgid "%r is neither \"page:<path>\", \"flow:<name>\", a URL name of the project nor a local path"
msgstr "%r no es \"page:<ruta>\", \"flow:<nombre>\", un nombre de URL del proyecto ni una ruta local"

#: designs/pipeline.py
msgid "only a computation sets fields"
msgstr "solo un cómputo fija campos"

#: designs/pipeline.py
msgid "only the last branch can go without a condition (the default): the ones after it would never be taken"
msgstr "solo la última rama puede ir sin condición (la de por defecto): las que vengan después nunca se tomarían"

#: designs/pipeline.py
#, python-format
msgid "%(step)s could not be completed: nothing was saved."
msgstr "No se pudo completar %(step)s: no se guardó nada."

#: designs/pipeline.py
#, python-format
msgid "%r is a process: a step of a wizard saves nothing, so it only runs validations and computations (put the process in the pipeline of the wizard, which runs when it finishes)"
msgstr "%r es un proceso: un paso de un asistente no guarda nada, así que solo corre validaciones y cómputos (ponga el proceso en el pipeline del asistente, que corre al terminar)"

#: designs/pipeline.py
msgid "a step of a wizard does not branch: only the wizard, when it finishes"
msgstr "un paso de un asistente no tiene ramas: solo el asistente, al terminar"

#: designs/data_components.py
#, python-format
msgid "%r is the site_field: the component sets it, the form cannot ask for it"
msgstr "%r es el site_field: lo llena el componente, el formulario no puede pedirlo"

#: designs/data_components.py
msgid "an inline table shows the rows of its parent: it takes no site_field"
msgstr "una tabla en línea muestra las filas de su padre: no lleva site_field"

#: designs/tree_timeline_metrics.py
msgid "a card has a period only when the node has a date_field"
msgstr "una tarjeta tiene periodo solo si el nodo tiene date_field"

#: designs/pipeline.py
#, python-format
msgid "%(name)r is a %(kind)s, not a %(said)s"
msgstr "%(name)r es de tipo %(kind)s, no %(said)s"

#: designs/regions.py
#, python-format
msgid "facets panel %(panel)r filters other rows than those of %(model)r"
msgstr "el panel de facetas %(panel)r filtra otras filas que las de %(model)r"
