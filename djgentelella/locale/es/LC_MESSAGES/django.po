msgstr "%r es el site_field: lo pone el asistente"

#: designs/wizard.py
#, python-format
msgid "a file of a wizard is uploaded in chunks (one of %s): a draft cannot keep a plain file input"
msgstr "un archivo de un asistente se sube por partes (uno de %s): un borrador no puede guardar un campo de archivo simple"

#: designs/wizard.py
#, python-format
msgid "\"when\" takes one of %s"
msgstr "\"when\" lleva uno de %s"

#: designs/wizard.py
#, python-format
msgid "%r is not a field of an earlier step"
msgstr "%r no es un campo de un paso anterior"

